      "css": ".ds-panel{background:var(--surface);border:1px solid #23303c;border-radius:var(--radius);min-width:0;overflow:hidden}.ds-generation-panel{grid-column:span 6;padding:23px 25px;position:relative}.ds-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-panel-heading h3{font-size:15px;line-height:1.4;font-weight:500;letter-spacing:-.015em}.ds-generation-total{margin-top:9px;display:flex;align-items:baseline;gap:10px;line-height:1.15}.ds-data-number{font-family:var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.04em;font-weight:450}.ds-generation-total .ds-data-number{font-size:46px;letter-spacing:-.04em}.ds-unit{font-family:var(--mono);color:var(--muted);font-size:17px;letter-spacing:-.03em}.ds-metric-description{font-size:12px;margin-top:3px;color:var(--muted)}.ds-panel{font-family:var(--font-sans,Geist),Arial,sans-serif;color:var(--ink,#f4f7fb)}.ds-panel h3,.ds-panel p{margin:0}.ds-panel p{margin-top:3px}"
